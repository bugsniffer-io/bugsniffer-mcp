{
  "name": "bugsniffer",
  "version": "0.1.0",
  "description": "Bugsniffer Sniff Score for AI coding agents: an MCP server and CLI that scores your web app's homepage and hands your agent the fixes.",
  "type": "module",
  "bin": {
    "bugsniffer": "dist/cli.js"
  },
  "main": "dist/server.js",
  "exports": {
    ".": "./dist/server.js",
    "./api": "./dist/api.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "qa",
    "testing",
    "lighthouse",
    "web-vitals",
    "cursor",
    "claude-code",
    "codex",
    "windsurf",
    "vibe-coding",
    "bugsniffer"
  ],
  "homepage": "https://bugsniffer.io/mcp",
  "bugs": {
    "email": "support@bugsniffer.io"
  },
  "mcpName": "io.bugsniffer/bugsniffer",
  "author": "Bugsniffer <support@bugsniffer.io>",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
